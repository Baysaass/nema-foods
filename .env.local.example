# Supabase Configuration
# Supabase хяналтын самбараас (Project Settings -> API) авсан мэдээллээ энд бичнэ үү.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Subdomain & Custom Domain Configuration (Админыг тусдаа дэд домэйн дээр ажиллуулах)
# 1. Хэрэв subdomain ашиглах бол жишээ нь:
ADMIN_HOST=admin
NEXT_PUBLIC_ADMIN_URL=https://admin.nemafoods.online
NEXT_PUBLIC_CATALOG_URL=https://nemafoods.online
